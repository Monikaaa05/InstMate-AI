# Copy this file to .env and replace the placeholder values.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
APP_BASE_URL=https://your-domain.example
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-unique-long-password
SESSION_COOKIE_SECURE=true
DATABASE_URL=sqlite:////data/instamate.db

# From Meta App Dashboard > Use cases > Manage messaging & content on Instagram > API setup with Unified login.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# The OAuth redirect URI must match the URL saved in your Unified Login configuration.
META_REDIRECT_URI=https://your-domain.example/api/instagram/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-separate-random-token
GRAPH_API_VERSION=v27.0

# Optional until AI replies are ready. Keep this value server-side.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
